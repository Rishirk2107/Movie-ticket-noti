# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=bms_watcher

# Server Port & CORS
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Optional Notifications (Brevo Email & ntfy)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BMS Ticket Alerts
NTFY_TOPIC=

# Optional BookMyShow Session Cookie & Outbound Proxy (http://, https://, or socks5://)
BMS_COOKIE=
BMS_PROXY_URL=
